rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // غيّر OWNER_UID بالـ UID بتاع حسابك من Authentication > Users
    function isOwner() {
      return request.auth != null && request.auth.uid == 'OWNER_UID';
    }
    function validUid() {
      return request.resource.data.uid == null
        || (request.auth != null && request.resource.data.uid == request.auth.uid);
    }

    // ===== الطلبات =====
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','address','notes','items','total','uid','status','createdAt'])
        && request.resource.data.keys().hasAll(['name','phone','address','items','total','status','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^01[0125][0-9]{8}$')
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 3 && request.resource.data.address.size() <= 300
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string && request.resource.data.notes.size() <= 300))
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0 && request.resource.data.total <= 100000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time
        && validUid();
      allow read, update, delete: if isOwner();
    }

    // ===== التقييمات =====
    // العميل يبعت تقييم approved=false، وإنت تغيّره true من الكونسول عشان يظهر
    match /reviews/{reviewId} {
      allow create: if request.resource.data.keys().hasOnly(['name','text','rating','approved','uid','createdAt'])
        && request.resource.data.keys().hasAll(['name','text','rating','approved','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 5 && request.resource.data.text.size() <= 400
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time
        && validUid();
      allow read: if resource.data.approved == true || isOwner();
      allow update, delete: if isOwner();
    }

    // أي حاجة تانية ممنوعة
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
